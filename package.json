{
  "name": "@deniscuciuc/redis-analyzer",
  "version": "1.2.0",
  "description": "CLI tool that analyzes Redis servers for memory pressure, cache efficiency, persistence safety, replication health, and slow commands.",
  "keywords": [
    "redis",
    "database",
    "analyzer",
    "performance",
    "cache",
    "cli",
    "memory",
    "replication",
    "slowlog",
    "devops"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deniscuciuc/db-analyzer-redis.git"
  },
  "bugs": {
    "url": "https://github.com/deniscuciuc/db-analyzer-redis/issues"
  },
  "license": "MIT",
  "author": "Denis Cuciuc <denis@deniscuciuc.dev>",
  "homepage": "https://github.com/deniscuciuc/db-analyzer-redis#readme",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "redis-analyzer": "./dist/src/cli/main.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "analyzerrc.example.json"
  ],
  "scripts": {
    "start": ". ./.env && npx ts-node src/cli/main.ts start",
    "analyze": ". ./.env && npx ts-node src/cli/main.ts",
    "analyze:help": "npx ts-node src/cli/main.ts --help",
    "analyze:health": ". ./.env && npx ts-node src/cli/main.ts -j -c health",
    "analyze:memory": ". ./.env && npx ts-node src/cli/main.ts -j -c memory",
    "analyze:hit-rate": ". ./.env && npx ts-node src/cli/main.ts -j -c hit-rate",
    "analyze:slow": ". ./.env && npx ts-node src/cli/main.ts -j -c slow-commands",
    "analyze:keys": ". ./.env && npx ts-node src/cli/main.ts -j -c keys",
    "analyze:connections": ". ./.env && npx ts-node src/cli/main.ts -j -c connections",
    "analyze:persistence": ". ./.env && npx ts-node src/cli/main.ts -j -c persistence",
    "analyze:replication": ". ./.env && npx ts-node src/cli/main.ts -j -c replication",
    "analyze:config": ". ./.env && npx ts-node src/cli/main.ts -j -c config",
    "analyze:html": ". ./.env && npx ts-node src/cli/main.ts --html -c full",
    "analyze:watch": ". ./.env && npx ts-node src/cli/main.ts -c health --watch 30",
    "server:info": ". ./.env && npx ts-node src/cli/main.ts -j -c server-info",
    "build": "rm -rf dist && tsc && node scripts/add-shebang.js",
    "postbuild": "node scripts/add-shebang.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test dist/tests/*.test.js",
    "prepublishOnly": "pnpm lint && pnpm build && pnpm test",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^22.20.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "sideEffects": false
}
