{
  "profiles": {
    "local": {
      "host": "localhost",
      "port": 6379,
      "db": 0
    },
    "prod": {
      "uri": "redis://:password@prod-redis.internal:6379/0",
      "tls": true
    }
  },
  "defaultProfile": "local",
  "slowCommandThreshold": 10000,
  "maxSlowCommands": 25,
  "output": "./reports"
}
